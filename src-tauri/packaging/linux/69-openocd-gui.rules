# USB access for JTAG/SWD debug probes, shipped by openocd-gui.
# The package postinst reloads udev so an already-plugged probe picks this up;
# otherwise replug it. Group `plugdev` is what Debian/Ubuntu's openocd rules use.

ACTION!="add|change", GOTO="openocd_gui_rules_end"
SUBSYSTEM!="usb", GOTO="openocd_gui_rules_end"

# STMicroelectronics ST-LINK / V2 / V2-1 / V3
ATTRS{idVendor}=="0483", ATTRS{idProduct}=="3744", MODE="0660", GROUP="plugdev", TAG+="uaccess"
ATTRS{idVendor}=="0483", ATTRS{idProduct}=="3748", MODE="0660", GROUP="plugdev", TAG+="uaccess"
ATTRS{idVendor}=="0483", ATTRS{idProduct}=="374b", MODE="0660", GROUP="plugdev", TAG+="uaccess"
ATTRS{idVendor}=="0483", ATTRS{idProduct}=="374d", MODE="0660", GROUP="plugdev", TAG+="uaccess"
ATTRS{idVendor}=="0483", ATTRS{idProduct}=="374e", MODE="0660", GROUP="plugdev", TAG+="uaccess"
ATTRS{idVendor}=="0483", ATTRS{idProduct}=="374f", MODE="0660", GROUP="plugdev", TAG+="uaccess"
ATTRS{idVendor}=="0483", ATTRS{idProduct}=="3752", MODE="0660", GROUP="plugdev", TAG+="uaccess"
ATTRS{idVendor}=="0483", ATTRS{idProduct}=="3753", MODE="0660", GROUP="plugdev", TAG+="uaccess"

